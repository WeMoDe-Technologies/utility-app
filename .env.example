# Kit — environment.
#
# Anything prefixed EXPO_PUBLIC_ is INLINED INTO THE APP BUNDLE at build time
# and is readable by anyone who downloads the app. Only ever put public values
# here. Secrets belong in CI, not in a mobile binary.

# Where the app looks for its update manifest. Together these resolve to
#   <URL>/storage/v1/object/public/<FOLDER>/version.json
# The bucket is public and the manifest is fetched with no credentials, which
# is why no key is needed at runtime.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_FOLDER_NAME=kit

# Public anon key. Not required to read the manifest (the bucket is public) and
# the app does not send it; kept here for future Supabase features.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: point the updater somewhere else entirely (staging, a CDN, a local
# file server while testing). Overrides the two values above when set.
# EXPO_PUBLIC_UPDATE_MANIFEST_URL=http://192.168.1.10:8000/version.json

# ---------------------------------------------------------------------------
# SERVER-ONLY. Deliberately NOT prefixed EXPO_PUBLIC_, so it is never bundled.
#
# A service_role key bypasses Row Level Security and grants full read/write
# access to the project. It must never ship in a mobile app, and no code under
# src/ may read it. Only needed if you script the manifest upload instead of
# using the Supabase dashboard — leave it empty otherwise.
#
# If this key has ever been committed or shared, rotate it in the dashboard.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_KEY=
